# --- Upstream market data provider (arjum) ---
ARJUM_API_BASE_URL=https://stock.arjum.com
ARJUM_API_KEY=changeme
# hard daily cap enforced by request_ledger; blueprint budget = 1000, reserve 200-250
DAILY_REQUEST_BUDGET=1000
DAILY_REQUEST_RESERVE=250

# --- Postgres ---
# Local dev (docker-compose.yml): postgres://idx:idx@localhost:5432/idx_smart_money
# App VM in production: point at the DB VM's PRIVATE IP, with the password
# set in infra/docker/.env on the DB VM -- see docker-compose.db.yml and the
# README's OCI two-VM deployment section.
DATABASE_URL=postgres://idx:idx@localhost:5432/idx_smart_money

# --- Redis (cache, single-flight leases, rate budget counters) ---
# Local dev: redis://localhost:6379
# Production: redis://:<REDIS_PASSWORD>@<DB_VM_PRIVATE_IP>:6379
REDIS_URL=redis://localhost:6379

# --- Object storage (raw payload archive, replay/audit) S3-compatible ---
# Local dev: MinIO via docker-compose.yml (values below match its defaults).
# Production on OCI: use OCI Object Storage's S3-compatible API instead of
# running MinIO on a VM -- create a bucket + Customer Secret Key in the OCI
# console, then set OBJECT_STORAGE_ENDPOINT to
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com and
# OBJECT_STORAGE_ACCESS_KEY/SECRET_KEY to that Customer Secret Key pair.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=idx-raw-archive
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# --- IDX trading session calendar (Asia/Jakarta) ---
SESSION_TIMEZONE=Asia/Jakarta
SESSION_MORNING_OPEN=09:00
SESSION_MORNING_CLOSE=11:30
SESSION_AFTERNOON_OPEN=13:30
SESSION_AFTERNOON_CLOSE=15:49
SESSION_FRIDAY_AFTERNOON_OPEN=14:00

# --- Web app / BFF ---
WEB_APP_SESSION_SECRET=changeme-32-byte-minimum-secret
NEXT_PUBLIC_APP_NAME="IDX Smart Money Decision Engine"

# --- Worker ---
WORKER_POLL_INTERVAL_MS=60000
WORKER_HEALTHCHECK_INTERVAL_MS=300000

# Deployment secrets (DEPLOY_APP_HOST, DEPLOY_APP_USER, DEPLOY_APP_SSH_KEY,
# DEPLOY_APP_PATH) are GitHub Actions repository secrets, not read by the
# application at runtime -- they don't belong in this file. See README's
# CI/CD section for where to set them.
