# Copy to infra/docker/.env on the DB VM only (used by docker-compose.db.yml).
# Never committed, never copied to the app VM.

# The DB VM's own private IP (from `ip addr` on that VM, or the OCI console's
# instance details -> "Private IP Address"). Both Postgres and Redis bind
# ONLY to this address -- see docker-compose.db.yml's comment on why.
DB_VM_PRIVATE_IP=10.0.1.10

POSTGRES_PASSWORD=changeme-generate-a-real-secret
REDIS_PASSWORD=changeme-generate-a-real-secret
